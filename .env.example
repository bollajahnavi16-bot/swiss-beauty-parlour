# Swiss Beauty Parlour — Environment Configuration Template
# Copy this file to .env (or .env.local) and populate with your Supabase credentials.
# NEVER commit your actual .env or production keys to version control!

# Supabase Project URL (Dashboard -> Project Settings -> Data API -> URL)
VITE_SUPABASE_URL=your_supabase_project_url

# Supabase Anonymous/Publishable Client Key (Dashboard -> Project Settings -> Data API -> Anon Key)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
